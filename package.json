{
  "name": "hazehash-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm build && pnpm -r --filter \"./packages/*\" test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "bench": "pnpm --filter hazehash-bench bench",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fetch-images": "node scripts/fetch-test-images.mjs",
    "changeset": "changeset",
    "e2e": "pnpm build && pnpm --filter hazehash-e2e test && pnpm --filter hazehash-e2e-nuxt test",
    "ablate": "pnpm --filter hazehash-bench ablate",
    "tune": "pnpm --filter hazehash-bench tune",
    "demo": "pnpm build && pnpm --filter hazehash-demo dev",
    "test:only": "pnpm -r --filter \"./packages/*\" test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.4",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsdown": "latest",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "unrun": "^0.3.1",
    "vitest": "^2.1.0"
  }
}
