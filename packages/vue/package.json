{
  "name": "hazehash-vue",
  "version": "0.1.1",
  "description": "Vue 3 component and composable for HazeHash image placeholders",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hazehash": "workspace:*",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.0",
    "happy-dom": "^15.0.0",
    "hazehash": "workspace:*",
    "vue": "^3.5.0"
  }
}
